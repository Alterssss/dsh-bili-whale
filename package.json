{
  "name": "dsh-bili-whale",
  "version": "1.0.0",
  "description": "DSH B站插件：持续浏览、动态记忆、自我归纳与有证据的心情和分享欲。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "bilibili",
    "agent",
    "diary"
  ],
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:startup": "node --test tests/scheduler-startup.test.mjs",
    "test:dynamic": "node --test tests/dynamic-memory.test.mjs",
    "test:state": "node --test tests/life-state-contract.test.mjs tests/memory-upgrade.test.mjs tests/audit-reliability.test.mjs"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "tools",
    "behavior",
    "cordis.patch.yml",
    "README.md",
    "tests",
    "LICENSE",
    "NOTICE.md",
    "LIFE-STATE-CONTRACT.md",
    "MEMORY-FIXES-2026-10-30.md",
    "MEMORY-FIXES-2026-10-31.md",
    "MEMORY-FIXES-2026-11-03.md",
    "MEMORY-FIXES-2026-11-04.md",
    "COMMUNITY-FIXES-2026-11-05.md",
    "vendor",
    "AFFECT-DIARY-FIXES-2026-11-18.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "license": "MIT",
  "dependencies": {},
  "engines": {
    "node": "^22.13.0 || >=23.4.0"
  }
}
